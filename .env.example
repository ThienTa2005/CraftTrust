# Public Supabase project configuration (safe for browser clients)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets: never expose these to a browser or mobile bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Trusted 3D generation worker (never expose these values to a browser).
PYTHON_BIN=python
MODEL_WORKER_POLL_MS=3000

# Canonical public origin used in QR/NFC passport URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo-only test payment switch. Production providers require separate setup.
ENABLE_TEST_CHECKOUT=true

